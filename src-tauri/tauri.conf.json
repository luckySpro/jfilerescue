{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JFileRescue",
  "version": "0.1.0",
  "identifier": "com.mjgroup.jfilerescue",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JFileRescue",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "publisher": "M&J Group",
    "copyright": "© 2025 M&J Group",
    "category": "Utility",
    "shortDescription": "只读文件找回工具",
    "longDescription": "JFileRescue 在 Windows 与 macOS 上以只读方式找回被删除的文件：指定目录找回与全盘找回。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "TradChinese", "English", "Japanese"],
        "displayLanguageSelector": true
      },
      "wix": { "language": ["zh-CN", "en-US"] }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/mjgroup/jfilerescue/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/mjgroup/jfilerescue/releases/latest/download/latest.json"
      ]
    }
  }
}
